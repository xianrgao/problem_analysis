            "columns": [
              "tg",
              "component",
              "pn",
              "position",
              "batch",
              "supplier",
              "bound_at",
              "event_id"
            ]
          },
          {
            "name": "equipment_changes",
            "kind": "table",
            "columns": [
              "station_id",
              "structure",
              "change_type",
              "occurred_at",
              "message"
            ]
          }
        ],
        "must_mention": [
          "日志覆盖范围"
        ],
        "must_not_claim": [
          "设备没有变化",
          "必须更换备件"
        ]
      }
    }
  ]
}
